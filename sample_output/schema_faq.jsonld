      "@type": "Question",
      "name": "Where is Tikka N Kabab?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "7859 McCallum Blvd Ste 106, Dallas, TX 75252, in far North Dallas about 2 miles from UT Dallas."
      }
    },
    {
      "@type": "Question",
      "name": "What are Tikka N Kabab's hours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Open every day from 11 AM to 9:30 PM."
      }
    },
    {
      "@type": "Question",
      "name": "What is Tikka N Kabab known for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pakistani and Indian food: Chicken 65 ($9.99), Butter Chicken and Chicken Tikka Masala ($12.99), Beef Nihari, BBQ/grill kababs, biryani and samosas ($3.99 for 2)."
      }
    },
    {
      "@type": "Question",
      "name": "Is Tikka N Kabab affordable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Samosas are $3.99 for two, Chicken 65 is $9.99 and most curries are $12.99."
      }
    },
    {
      "@type": "Question",
      "name": "Can I order Tikka N Kabab online?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, at https://www.tikkankababtx.com or with Order online on Google. Phone: (469) 857-3000."
      }
    }
  ]
