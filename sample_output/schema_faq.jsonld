      "@type": "Question",
      "name": "Where is Tikka N Kabab?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "7859 McCallum Blvd Ste 106, Dallas, TX 75252, in far North Dallas about 2 miles from UT Dallas."
      }
    },
    {
      "@type": "Question",
      "name": "What are Tikka N Kabab's hours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Open every day from 11 AM to 9:30 PM."
      }
    },
    {
      "@type": "Question",
      "name": "What is Tikka N Kabab known for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Chicken 65 ($9.99), Chicken Samosa ($2.99 for 2), Veg Samosa ($3.99 for 2), Onion Bhaji ($5.99) and Dal Puri ($4.99 for 4)."
      }
    },
    {
      "@type": "Question",
      "name": "Is Tikka N Kabab affordable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Samosas start at $2.99 and most snacks are under $6; Chicken 65 is $9.99."
      }
    },
    {
